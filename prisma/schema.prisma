// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id        String    @id @default(uuid())
  name      String
  company   String
  email     String    @unique
  phone     String
  website   String?
  joinDate  String
  status    String    @default("Active")
  pocName   String?
  pocEmail  String?
  services  Service[]
  bills     Bill[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Service {
  id        String   @id @default(uuid())
  name      String
  startDate String
  endDate   String
  price     Float
  status    String   @default("Active")
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Bill {
  id         String   @id @default(uuid())
  month      String
  amount     Float
  status     String   @default("Paid")
  datePaid   String
  invoiceUri String   @default("#")
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model User {
  id                  String               @id @default(uuid())
  name                String
  email               String               @unique
  password            String
  role                String               @default("user") // "user" | "admin"
  accessRequests      AccessRequest[]
  nutritionProfile    UserNutritionProfile?
  nutritionLogs       Meal[]
  favoriteFoods       FavoriteFood[]
  savedMeals          SavedMeal[]
  // Daily Quests Gamification Module
  questProfile        UserQuestProfile?
  questLogs           QuestLog[]            @relation("QuestLogUser")
  playerStats         PlayerStats?
  userAchievements    UserAchievement[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model UserNutritionProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  age            Int?
  gender         String?  // male | female | other
  heightCm       Float?
  weightKg       Float?
  activityLevel  String?  // sedentary | light | moderate | active | very_active
  goal           String?  // lose | maintain | gain
  targetCalories Float    @default(2000)
  targetProtein  Float    @default(140)
  targetCarbs    Float    @default(250)
  targetFat      Float    @default(70)
  targetFiber    Float    @default(30)
  dietPreference String   @default("Non-vegetarian") // Vegetarian | Eggetarian | Vegan | Non-vegetarian
  focusAreas     String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model FoodItem {
  id             String          @id @default(uuid())
  name           String
  category       String          @default("General") // Staples | Protein | Vegetables | Fruits | Dairy | Snacks | Beverages
  servingSize    Float           @default(100)
  servingUnit    String          @default("g") // g | piece | bowl | roti | cup | glass | tbsp | tsp
  calories       Float
  protein        Float
  carbs          Float
  fat            Float
  fiber          Float           @default(0)
  sugar          Float           @default(0)
  saturatedFat   Float           @default(0)
  sodium         Float           @default(0) // mg
  potassium      Float           @default(0) // mg
  calcium        Float           @default(0) // mg
  iron           Float           @default(0) // mg
  magnesium      Float           @default(0) // mg
  zinc           Float           @default(0) // mg
  vitaminA       Float           @default(0) // mcg
  vitaminC       Float           @default(0) // mg
  vitaminD       Float           @default(0) // mcg
  vitaminB12     Float           @default(0) // mcg
  folate         Float           @default(0) // mcg
  isVerified     Boolean         @default(true)
  mealItems      MealItem[]
  favoriteBy     FavoriteFood[]
  savedMealItems SavedMealItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([name])
}

model Meal {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String     // YYYY-MM-DD
  mealType  String     // Breakfast | Lunch | Snack | Dinner
  items     MealItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId, date])
}

model MealItem {
  id         String   @id @default(uuid())
  mealId     String
  meal       Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  foodId     String
  food       FoodItem @relation(fields: [foodId], references: [id])
  quantity   Float    // multiplier of default serving unit/size
  unit       String   // serving unit used
  calories   Float
  protein    Float
  carbs      Float
  fat        Float
  fiber      Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model FavoriteFood {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodId    String
  food      FoodItem @relation(fields: [foodId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, foodId])
}

model SavedMeal {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  items     SavedMealItem[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model SavedMealItem {
  id          String    @id @default(uuid())
  savedMealId String
  savedMeal   SavedMeal @relation(fields: [savedMealId], references: [id], onDelete: Cascade)
  foodId      String
  food        FoodItem  @relation(fields: [foodId], references: [id])
  quantity    Float
  unit        String
  createdAt   DateTime  @default(now())
}

model Module {
  id             String          @id @default(uuid())
  slug           String          @unique
  title          String
  description    String
  icon           String
  href           String
  accessRequests AccessRequest[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model AccessRequest {
  id        String   @id @default(uuid())
  status    String   @default("pending") // "pending" | "approved" | "rejected"
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId  String
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, moduleId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// =====================================================================
// Daily Quests Gamification Module — §6 Data Models
// =====================================================================

enum QuestStatus {
  active
  completed
  failed
}

enum QuestType {
  workout
  study
  reading
}

model UserQuestProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  onboardedAt        DateTime? // set after the first-run wizard finishes
  startedAt          DateTime @default(now())
  role               String   @default("adult") // "student" | "adult"
  rotation           String   @default("auto") // "auto" | "manual"
  workoutCapMinutes  Int      @default(120)
  studyCapMinutes    Int      @default(180)
  readingCapMinutes  Int      @default(90)
  heavyDayMultiplier Float    @default(1.25)
  resetHour          Int      @default(23) // daily deadline hour (23 = 23:59 local) or 5 for early birds
  questSeed          Int      @default(0) // per-user variety seed: rotates workout disciplines & picks task flavor variants
  lastCompleteKey    String? // last YYYY-MM-DD with a completed task (streak anchor)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  questLogs QuestLog[] @relation("QuestLogProfile")
}

model QuestLog {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation("QuestLogUser", fields: [userId], references: [id], onDelete: Cascade, map: "QuestLog_user_fkey")
  profile         UserQuestProfile @relation("QuestLogProfile", fields: [userId], references: [userId], onDelete: Cascade, map: "QuestLog_profile_fkey")
  date            String // YYYY-MM-DD local day key (one quest per user per day)
  questType       QuestType
  discipline      String? // strength | cardio | mobility | endurance (workout only)
  variant         Int      @default(0) // task flavor variant index chosen at issue time (per-user variety)
  targetMinutes   Int
  progressMinutes Int         @default(0)
  status          QuestStatus @default(active)
  reflectionNote  String?
  awardedXp       Int         @default(0)
  completedAt     DateTime?
  perfectDay      Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([userId, date])
  @@index([userId, status])
  @@index([userId, date])
}

model PlayerStats {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  xp           Int      @default(0)
  strength     Int      @default(0)
  agility      Int      @default(0)
  stamina      Int      @default(0)
  intelligence Int      @default(0)
  sense        Int      @default(0)
  streak       Int      @default(0)
  bestStreak   Int      @default(0)
  perfectDays  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Achievement {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  description String
  icon        String
  color       String           @default("#f59e0b")
  predicate   String // JSON condition string evaluated by the engine
  order       Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  users UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(uuid())
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
}


